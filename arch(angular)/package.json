{
  "name": "projects",
  "version": "0.0.0",
  "scripts": {
    "build:lib": "ng build lib-identity --watch",
    "build:admin": "ng build app-identity-admin --watch",
    "build:user": "ng build app-identity-user --watch",
    "build:all": "ng build --watch",
    "serve:ssr-skip:admin": "ng serve app-identity-admin",
    "serve:ssr-skip:user": "ng serve app-identity-user",
    "serve:ssr-skip:all": "concurrently -n admin,user -c blue,green \"ng serve app-identity-admin\" \"ng serve app-identity-user\"",
    "serve:ssr:admin": "node dist/app-identity-admin/server/server.mjs",
    "serve:ssr:user": "node dist/app-identity-user/server/server.mjs",
    "serve:ssr:all": "concurrently -n admin,user -c blue,green \"node dist/app-identity-admin/server/server.mjs\" \"node dist/app-identity-user/server/server.mjs\"",
    "test:lib": "ng test lib-identity",
    "test:admin": "ng test app-identity-admin",
    "test:user": "ng test app-identity-user",
    "test:all": "ng test",
    "watch": "ng build --watch --configuration development",
    "e2e:admin": "playwright test --project=admin --headed",
    "e2e:user": "playwright test --project=user --headed",
    "e2e:all": "playwright test --headed",
    "e2e:report": "playwright show-report"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/cdk": "^21.1.5",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/localize": "^21.1.4",
    "@angular/platform-browser": "^21.1.0",
    "@angular/platform-server": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/ssr": "^21.1.4",
    "@microsoft/signalr": "^10.0.0",
    "@ngrx/signals": "^21.0.1",
    "@progress/kendo-angular-buttons": "^23.0.1",
    "@progress/kendo-angular-common": "^23.0.1",
    "@progress/kendo-angular-dialog": "^23.0.1",
    "@progress/kendo-angular-dropdowns": "^23.0.1",
    "@progress/kendo-angular-grid": "^23.0.1",
    "@progress/kendo-angular-icons": "^23.0.1",
    "@progress/kendo-angular-indicators": "^23.0.1",
    "@progress/kendo-angular-inputs": "^23.0.1",
    "@progress/kendo-angular-intl": "^23.0.1",
    "@progress/kendo-angular-label": "^23.0.1",
    "@progress/kendo-angular-layout": "^23.0.1",
    "@progress/kendo-angular-notification": "^23.0.1",
    "@progress/kendo-angular-popup": "^23.0.1",
    "@progress/kendo-angular-tooltip": "^23.0.1",
    "@progress/kendo-data-query": "^1.7.3",
    "@progress/kendo-licensing": "^1.10.1",
    "@progress/kendo-svg-icons": "^4.8.0",
    "@progress/kendo-theme-material": "^13.0.0",
    "express": "^5.1.0",
    "luxon": "^3.7.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20.17.19",
    "concurrently": "^9.2.1",
    "jsdom": "^27.1.0",
    "ng-packagr": "^21.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
